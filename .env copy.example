# ============================================================================
# ANTIGRAVITY AI TRADING SYSTEM — Environment Configuration
# ============================================================================
# Copy to .env and fill in your values. Never commit .env to version control.
# ============================================================================

# --- Mode -------------------------------------------------------------------
# LIVE | DRY_RUN | REPLAY | BACKTEST (default: DRY_RUN)
TRADING_MODE=DRY_RUN
TRADING_SYMBOLS=XAUUSDc,EURUSDc,GBPUSDc,USDJPYc

# --- Account Currency (USC = Exness Standard Cent) ---
# AUTO = auto-detect from MT5 | USD = force Standard | USC = force Cent
ACCOUNT_CURRENCY=USC
LOT_MODE=CENT

# --- MT5 Connection ----------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT=10000

# --- QuestDB -----------------------------------------------------------------
QUESTDB_HOST=localhost
QUESTDB_HTTP_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=quest
# JVM heap for QuestDB container (low-RAM mode)
QUESTDB_JAVA_OPTS=-Xms256m -Xmx512m

# --- SQLite (embedded) -------------------------------------------------------
SQLITE_DB_PATH=backend/data/sqlite/trading.db

# --- DuckDB (analytics) ------------------------------------------------------
DUCKDB_DB_PATH=backend/data/duckdb/analytics.duckdb

# --- Risk Engine (hard limits) ------------------------------------------------
MAX_RISK_PER_TRADE_PCT=2.0
MAX_POSITIONS_PER_SYMBOL=2
CAPITAL_FLOOR_PCT=90.0
FLOATING_DD_BLOCK_PCT=10.0
BREAKEVEN_R_MULTIPLE=1.0
NEWS_BLOCK_MINUTES=30
DAILY_TARGET_AMOUNT=0
DAILY_STOP_AMOUNT=0

# --- API Server ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# --- Telegram Notifications ---------------------------------------------------
# Get token from @BotFather, chat ID from getUpdates API
TELEGRAM_BOT_TOKEN=8258549448:AAGf6104VHQYkme9AJNRKHwhKSeHKTyauuE
TELEGRAM_CHAT_ID=-5144094671
TELEGRAM_ENABLED=true

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
