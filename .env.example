# ============================================================================
# ANTIGRAVITY AI TRADING SYSTEM — Environment Configuration
# ============================================================================
# Copy to .env and fill in your values. Never commit .env to version control.
# ============================================================================
# ---   ของพอตตัวเอง  14xxxxxxx
# --- Mode -------------------------------------------------------------------
# LIVE | DRY_RUN | REPLAY | BACKTEST (default: DRY_RUN)
TRADING_MODE=LIVE
TRADING_SYMBOLS=XAUUSDc,XAGUSDc

# --- Account Currency (USC = Exness Standard Cent) ---
ACCOUNT_CURRENCY=USC
LOT_MODE=CENT

# --- MT5 Connection ----------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT=10000


# --- SQLite (embedded) -------------------------------------------------------
SQLITE_DB_PATH=backend/data/sqlite/trading.db

# --- DuckDB (analytics) ------------------------------------------------------
DUCKDB_DB_PATH=backend/data/duckdb/analytics.duckdb

# --- Risk Engine (hard limits) ------------------------------------------------
MAX_RISK_PER_TRADE_PCT=7
MAX_POSITIONS_PER_SYMBOL=3
CAPITAL_FLOOR_PCT=90.0
FLOATING_DD_BLOCK_PCT=30.0
BREAKEVEN_R_MULTIPLE=0.5
NEWS_BLOCK_MINUTES=30
DAILY_TARGET_AMOUNT=2800
DAILY_STOP_AMOUNT=1400

# --- Scalping Risk Parameters ("เข้าไวออกไว") ---
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=1.5

GUARDIAN_TRAILING_MODE=step
GUARDIAN_TRAILING_ACTIVATION_R=0.5
GUARDIAN_TRAILING_STEP_R=0.25

TP_MANAGEMENT_MODE=partial
TP_PARTIAL_TIER1_R=0.5
TP_PARTIAL_TIER1_PCT=0.5
TP_PARTIAL_TIER2_R=1.0
TP_PARTIAL_TIER2_PCT=1.0

# --- API Server ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# --- Telegram Notifications ---------------------------------------------------
TELEGRAM_BOT_TOKEN=8258549448:AAGf6104VHQYkme9AJNRKHwhKSeHKTyauuE
# TELEGRAM_CHAT_ID=-5144094671
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Shadow Mode --------------------------------------------------------------
SHADOW_ENABLED=true
