# ============================================================================
# 🪙 CENT ACCOUNT (SMALL) — Profile Config
# ============================================================================
# Account: Exness Standard Cent | Login: 183302855
# Balance: ~4,640 USC (~$46) | Equity: ~3,507 USC (~$35)
# สร้างเมื่อ: 2026-02-24
#
# วิธีใช้: คัดลอกไปทับ .env → restart bot
#   Copy-Item .env.cent_small .env -Force
#   cd backend; python run_bot.py --mode LIVE
# ============================================================================

# --- Mode ---
TRADING_MODE=LIVE
TRADING_SYMBOLS=XAUUSDc,XAGUSDc

# --- Account (Exness Standard Cent) ---
ACCOUNT_CURRENCY=USC
LOT_MODE=CENT

# --- MT5 Connection ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT=10000

# --- Database ---
SQLITE_DB_PATH=backend/data/sqlite/trading.db
DUCKDB_DB_PATH=backend/data/duckdb/analytics.duckdb

# ============================================================================
# RISK ENGINE — ปรับสำหรับพอร์ตเล็ก (equity ~$35)
# ============================================================================
# ใช้ risk สูงขึ้นเล็กน้อยเพราะเป็น Cent Account (เงินจริง ~$46)
MAX_RISK_PER_TRADE_PCT=7
MAX_POSITIONS_PER_SYMBOL=4
MAX_TOTAL_POSITIONS=3
CAPITAL_FLOOR_PCT=85.0
FLOATING_DD_BLOCK_PCT=30.0
BREAKEVEN_R_MULTIPLE=0.5
NEWS_BLOCK_MINUTES=30

# --- Daily Limits (ตั้งต่ำเพราะพอร์ตเล็ก) ---
DAILY_TARGET_AMOUNT=500
DAILY_STOP_AMOUNT=300

# ============================================================================
# SCALPING PARAMETERS — เข้าไว ออกไว
# ============================================================================
SL_ATR_MULTIPLIER=1.5
TP_ATR_MULTIPLIER=1.5
SL_MIN_DISTANCE_POINTS=100

# --- Trailing Stop (เร็ว + แน่น) ---
GUARDIAN_TRAILING_MODE=step
GUARDIAN_TRAILING_ACTIVATION_R=0.5
GUARDIAN_TRAILING_STEP_R=0.25
GUARDIAN_TRAILING_ATR_MULT=1.5

# --- TP Management (Partial Close เร็ว) ---
TP_MANAGEMENT_MODE=partial
TP_PARTIAL_TIER1_R=0.5
TP_PARTIAL_TIER1_PCT=0.5
TP_PARTIAL_TIER2_R=1.0
TP_PARTIAL_TIER2_PCT=1.0

# ============================================================================
# OVERTRADING PROTECTION — คุมเข้มเพราะพอร์ตเล็ก
# ============================================================================
COOLDOWN_MINUTES_AFTER_LOSS=5
MAX_CONSECUTIVE_LOSSES_SESSION=2
MAX_TRADES_PER_SESSION=3
MAX_DAILY_LOSS_PCT=5.0
MAX_DAILY_TRADES_FX=2
MAX_DAILY_TRADES_GOLD=2

# --- Risk Dampening (ลด lot เมื่อแพ้ติด) ---
RISK_DAMPENING_ENABLED=true
RISK_DAMPENER_LOSS1_MULT=0.7
RISK_DAMPENER_LOSS2_MULT=0.5
RISK_DAMPENER_LOSS3_MULT=0.3

# ============================================================================
# API & FRONTEND
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=8258549448:AAGf6104VHQYkme9AJNRKHwhKSeHKTyauuE
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Shadow & Training ---
SHADOW_ENABLED=true
TRAINING_ENABLED=true
TRAINING_INTERVAL_HOURS=1.0

# --- Regime Filter ---
REGIME_FILTER_ENABLED=true
REGIME_ADX_MIN=10.0

# --- Sentiment ---
SENTIMENT_ENABLED=true
ML_PATTERN_ENABLED=true
