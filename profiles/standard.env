# --- Mode ---
TRADING_MODE=LIVE
TRADING_SYMBOLS=XAUUSD,XAGUSD,BTCUSD

# --- Account (Exness Standard) ---
ACCOUNT_CURRENCY=USD
LOT_MODE=STANDARD

# --- MT5 Connection ---
MT5_LOGIN=413184109
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial6
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT=10000

# --- Database ---
SQLITE_DB_PATH=backend/data/sqlite/trading.db
DUCKDB_DB_PATH=backend/data/duckdb/analytics.duckdb

# ============================================================================
# RISK ENGINE — ปรับสำหรับ Standard Account ($105)
# ============================================================================
MAX_RISK_PER_TRADE_PCT=5
MAX_POSITIONS_PER_SYMBOL=2
MAX_TOTAL_POSITIONS=4
CAPITAL_FLOOR_PCT=85.0
FLOATING_DD_BLOCK_PCT=15.0
BREAKEVEN_R_MULTIPLE=1.0
NEWS_BLOCK_MINUTES=30

# --- Daily Limits ---
DAILY_TARGET_AMOUNT=60
DAILY_VAULT_AMOUNT=18
DAILY_STOP_AMOUNT=14

# ============================================================================
# SCALPING PARAMETERS
# ============================================================================
SL_ATR_MULTIPLIER=2.0
TP_ATR_MULTIPLIER=2.0
SL_MIN_DISTANCE_POINTS=200

# --- Trailing Stop ---
GUARDIAN_TRAILING_MODE=step
GUARDIAN_TRAILING_ACTIVATION_R=1.0
GUARDIAN_TRAILING_STEP_R=0.5
GUARDIAN_TRAILING_ATR_MULT=2.0

# --- TP Management (Partial Close) ---
TP_MANAGEMENT_MODE=partial
TP_PARTIAL_TIER1_R=1.0
TP_PARTIAL_TIER1_PCT=0.5
TP_PARTIAL_TIER2_R=2.0
TP_PARTIAL_TIER2_PCT=1.0

# ============================================================================
# OVERTRADING PROTECTION
# ============================================================================
COOLDOWN_MINUTES_AFTER_LOSS=10
MAX_CONSECUTIVE_LOSSES_SESSION=3
MAX_TRADES_PER_SESSION=5
MAX_DAILY_LOSS_PCT=10.0
MAX_DAILY_TRADES_FX=3
MAX_DAILY_TRADES_GOLD=5

# --- Risk Dampening ---
RISK_DAMPENING_ENABLED=true
RISK_DAMPENER_LOSS1_MULT=0.7
RISK_DAMPENER_LOSS2_MULT=0.5
RISK_DAMPENER_LOSS3_MULT=0.3

# ============================================================================
# API & FRONTEND
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=8258549448:AAGf6104VHQYkme9AJNRKHwhKSeHKTyauuE
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Shadow & Training ---
SHADOW_ENABLED=true
TRAINING_ENABLED=true
TRAINING_INTERVAL_HOURS=1.0

# --- Regime Filter ---
REGIME_FILTER_ENABLED=true
REGIME_ADX_MIN=10.0

# --- Sentiment ---
SENTIMENT_ENABLED=true
ML_PATTERN_ENABLED=true
