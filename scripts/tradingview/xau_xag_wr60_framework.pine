//@version=5
strategy("XAU/XAG WR60 Trend Pullback Framework", overlay=true, pyramiding=0, process_orders_on_close=true, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.03)

// -----------------------------
// Core settings
// -----------------------------
higherTf = input.timeframe("60", "Trend Timeframe (recommend H1)")
emaFastLen = input.int(50, "HTF EMA Fast", minval=1)
emaSlowLen = input.int(200, "HTF EMA Slow", minval=1)
pullbackEmaLen = input.int(20, "Entry EMA (chart TF)", minval=1)
rsiLen = input.int(2, "RSI Length", minval=1)
rsiLongThreshold = input.float(15, "RSI Oversold (Long)", minval=1, maxval=50)
rsiShortThreshold = input.float(85, "RSI Overbought (Short)", minval=50, maxval=99)
atrLen = input.int(14, "ATR Length", minval=1)
slAtrMult = input.float(1.0, "Stop Loss ATR Multiplier", minval=0.1, step=0.1)
tpAtrMult = input.float(1.2, "Take Profit ATR Multiplier", minval=0.1, step=0.1)

allowLong = input.bool(true, "Enable Long")
allowShort = input.bool(true, "Enable Short")

// -----------------------------
// Risk settings
// -----------------------------
useRiskSizing = input.bool(true, "Use Risk-Based Position Sizing")
riskPerTradePct = input.float(0.5, "Risk % per Trade", minval=0.1, maxval=5, step=0.1)
fixedQty = input.float(1.0, "Fixed Qty (if risk sizing off)", minval=0.0001, step=0.01)
minQty = input.float(0.01, "Min Qty", minval=0.0001, step=0.01)
qtyStep = input.float(0.01, "Qty Step", minval=0.0001, step=0.01)
maxDailyLossPct = input.float(2.0, "Max Daily Loss % (stop new entries)", minval=0.5, maxval=20, step=0.5)

// -----------------------------
// Optional time/news filters
// -----------------------------
useSessionFilter = input.bool(false, "Use Session Filter")
tradeSession = input.session("0700-1700", "Trading Session (exchange time)")

useNewsFilter = input.bool(true, "Use Manual News Window Filter")
newsBeforeMin = input.int(30, "Block Minutes Before News", minval=0, maxval=240)
newsAfterMin = input.int(30, "Block Minutes After News", minval=0, maxval=240)

useNews1 = input.bool(false, "Enable News Event #1")
newsTs1 = input.time(timestamp("2026-01-15T13:30:00"), "News Event #1 Time")
useNews2 = input.bool(false, "Enable News Event #2")
newsTs2 = input.time(timestamp("2026-01-29T19:00:00"), "News Event #2 Time")
useNews3 = input.bool(false, "Enable News Event #3")
newsTs3 = input.time(timestamp("2026-02-06T13:30:00"), "News Event #3 Time")
useNews4 = input.bool(false, "Enable News Event #4")
newsTs4 = input.time(timestamp("2026-02-18T19:00:00"), "News Event #4 Time")
useNews5 = input.bool(false, "Enable News Event #5")
newsTs5 = input.time(timestamp("2026-03-06T13:30:00"), "News Event #5 Time")

isInNewsWindow(eventTs, beforeMin, afterMin) =>
    windowStart = eventTs - beforeMin * 60000
    windowEnd = eventTs + afterMin * 60000
    time >= windowStart and time <= windowEnd

inNewsWindow = useNewsFilter and (
     (useNews1 and isInNewsWindow(newsTs1, newsBeforeMin, newsAfterMin)) or
     (useNews2 and isInNewsWindow(newsTs2, newsBeforeMin, newsAfterMin)) or
     (useNews3 and isInNewsWindow(newsTs3, newsBeforeMin, newsAfterMin)) or
     (useNews4 and isInNewsWindow(newsTs4, newsBeforeMin, newsAfterMin)) or
     (useNews5 and isInNewsWindow(newsTs5, newsBeforeMin, newsAfterMin))
)

inSession = not na(time(timeframe.period, tradeSession))

// -----------------------------
// Higher timeframe trend filter
// -----------------------------
htfClose = request.security(syminfo.tickerid, higherTf, close, barmerge.gaps_off, barmerge.lookahead_off)
htfEmaFast = request.security(syminfo.tickerid, higherTf, ta.ema(close, emaFastLen), barmerge.gaps_off, barmerge.lookahead_off)
htfEmaSlow = request.security(syminfo.tickerid, higherTf, ta.ema(close, emaSlowLen), barmerge.gaps_off, barmerge.lookahead_off)

longTrend = htfClose > htfEmaSlow and htfEmaFast > htfEmaSlow
shortTrend = htfClose < htfEmaSlow and htfEmaFast < htfEmaSlow

// -----------------------------
// Entry setup (chart timeframe)
// -----------------------------
entryEma = ta.ema(close, pullbackEmaLen)
rsi2 = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)

touchLong = low <= entryEma
touchShort = high >= entryEma
bullReversal = close > open and close > high[1]
bearReversal = close < open and close < low[1]

longSignalRaw = longTrend and touchLong and rsi2 < rsiLongThreshold and bullReversal
shortSignalRaw = shortTrend and touchShort and rsi2 > rsiShortThreshold and bearReversal

// -----------------------------
// Daily risk stop
// -----------------------------
var float dayStartEquity = na
isNewDay = ta.change(time("D")) != 0
if na(dayStartEquity) or isNewDay
    dayStartEquity := strategy.equity

dailyLossPct = dayStartEquity > 0 ? (dayStartEquity - strategy.equity) / dayStartEquity * 100 : 0
dailyLossHit = dailyLossPct >= maxDailyLossPct

canTrade = not dailyLossHit and (not useSessionFilter or inSession) and not inNewsWindow

// -----------------------------
// Position sizing
// -----------------------------
stopDistance = atr * slAtrMult
pointValue = math.max(syminfo.pointvalue, 0.0000001)
riskCash = strategy.equity * riskPerTradePct / 100.0
rawQty = stopDistance > 0 ? riskCash / (stopDistance * pointValue) : fixedQty
stepQty = math.floor(rawQty / qtyStep) * qtyStep
riskQty = math.max(stepQty, minQty)
tradeQty = useRiskSizing ? riskQty : fixedQty
tradeQty := math.max(tradeQty, minQty)

// -----------------------------
// Orders and exits
// -----------------------------
flat = strategy.position_size == 0
longSignal = flat and allowLong and canTrade and longSignalRaw
shortSignal = flat and allowShort and canTrade and shortSignalRaw

var float atrOnEntry = na
if longSignal
    atrOnEntry := atr
    strategy.entry("L", strategy.long, qty=tradeQty)
if shortSignal
    atrOnEntry := atr
    strategy.entry("S", strategy.short, qty=tradeQty)

entryAtr = na(atrOnEntry) ? atr : atrOnEntry

if strategy.position_size > 0
    longStop = strategy.position_avg_price - (entryAtr * slAtrMult)
    longTake = strategy.position_avg_price + (entryAtr * tpAtrMult)
    strategy.exit("L-Exit", "L", stop=longStop, limit=longTake)

if strategy.position_size < 0
    shortStop = strategy.position_avg_price + (entryAtr * slAtrMult)
    shortTake = strategy.position_avg_price - (entryAtr * tpAtrMult)
    strategy.exit("S-Exit", "S", stop=shortStop, limit=shortTake)

if strategy.position_size == 0 and strategy.position_size[1] != 0
    atrOnEntry := na

// -----------------------------
// Visuals
// -----------------------------
plot(entryEma, "Entry EMA", color=color.orange, linewidth=2)
plot(htfEmaFast, "HTF EMA Fast", color=color.new(color.green, 25))
plot(htfEmaSlow, "HTF EMA Slow", color=color.new(color.blue, 25))

plotshape(longSignal, title="Long Signal", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny, text="L")
plotshape(shortSignal, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="S")

bgcolor(inNewsWindow ? color.new(color.yellow, 88) : na, title="News Block")
bgcolor(dailyLossHit ? color.new(color.red, 86) : na, title="Daily Loss Block")

// -----------------------------
// Alerts
// -----------------------------
alertcondition(longSignal, "Long Entry", "Long setup triggered on {{ticker}} {{interval}}")
alertcondition(shortSignal, "Short Entry", "Short setup triggered on {{ticker}} {{interval}}")
alertcondition(dailyLossHit, "Daily Loss Hit", "Daily loss limit reached on {{ticker}}")
