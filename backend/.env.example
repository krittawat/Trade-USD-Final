# Antigravity AI Trading System — Environment Configuration
# Copy this to .env and fill in your credentials

# --- Mode ---
TRADING_MODE=DRY_RUN

# --- Symbols ---
# Comma-separated list of symbols to trade (supports Gold, Forex, Crypto, etc.)
# Exness suffix: add 'm' for micro accounts (XAUUSDm, EURUSDm)
# Examples: XAUUSDm,EURUSDm,GBPUSDm,USDJPYm,BTCUSDm
TRADING_SYMBOLS=XAUUSDm,EURUSDm,GBPUSDm,USDJPYm

# --- MT5 Credentials ---
# Fill these with your Exness MT5 account details
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Real
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT=10000

# --- QuestDB ---
QUESTDB_HOST=localhost
QUESTDB_HTTP_PORT=9000
QUESTDB_ILP_PORT=9009
QUESTDB_PG_PORT=8812

# --- SQLite ---
SQLITE_DB_PATH=backend/data/sqlite/trading.db

# --- DuckDB ---
DUCKDB_DB_PATH=backend/data/duckdb/analytics.duckdb

# --- Risk Engine ---
MAX_RISK_PER_TRADE_PCT=2.0
MAX_POSITIONS_PER_SYMBOL=2
CAPITAL_FLOOR_PCT=90.0
FLOATING_DD_BLOCK_PCT=10.0
BREAKEVEN_R_MULTIPLE=1.0
NEWS_BLOCK_MINUTES=30

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
